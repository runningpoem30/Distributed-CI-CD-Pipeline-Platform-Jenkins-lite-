# ═══════════════════════════════════════
# ForgeCI — Root .gitignore
# ═══════════════════════════════════════

# ── Java / Maven ──
target/
*.class
*.jar
*.war
*.ear
*.log
hs_err_pid*

# ── IDE ──
.idea/
*.iml
.vscode/
.settings/
.project
.classpath
*.swp
*.swo
*~
.DS_Store

# ── Node / Next.js ──
node_modules/
.next/
out/
.vercel/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── Environment variables (CRITICAL — contains secrets) ──
.env
.env.local
.env.*.local
*.env

# ── Docker ──
docker-compose.override.yml

# ── OS ──
.DS_Store
Thumbs.db
desktop.ini

# ── Misc ──
*.bak
*.tmp
*.temp
*.resolved
